<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsUraPlugin>true</IsUraPlugin>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>2026.3.25</Version>
		<!-- 自动把本插件的 NuGet 依赖闭包拷到输出。 -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

		<PluginInternalName>DMMPlugin</PluginInternalName>
		<PluginDisplayName>DMM插件</PluginDisplayName>
		<PluginAuthor>Lipi</PluginAuthor>
		<PluginTargets>Cygames</PluginTargets>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.5" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="tests\**" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="i18n\DMM.Designer.cs">
			<DependentUpon>DMM.resx</DependentUpon>
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="i18n\DMM.ja-JP.resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
		<EmbeddedResource Update="i18n\DMM.resx">
			<LastGenOutput>DMM.Designer.cs</LastGenOutput>
			<Generator>ResXFileCodeGenerator</Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="i18n\DMM.zh-CN.resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="UmamusumeResponseAnalyzer" Version="2026.9.1" />
	</ItemGroup>

</Project>
